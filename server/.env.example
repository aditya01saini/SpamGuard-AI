# ---------------------------------------------------------------------------
# SpamGuard AI — Backend environment variables (SAFE TO COMMIT — placeholders)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Mistral AI (https://console.mistral.ai/) — required for AI explanation layer.
# Leave empty to run without AI explanations (ML + rules still work).
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/spamguard

# Server
PORT=8000
CLIENT_URL=http://localhost:5173

# Uploads
MAX_FILE_SIZE_MB=5
